<?xml version="1.0" encoding="utf-8"?>
<!-- Same five pipes as assets/logo.svg (post-Inkscape recentering — the
     translate()s from there are already baked into these coordinates),
     redrawn for the adaptive icon safe zone (center ~66 of 108dp).
     Rounded corners dropped — invisible at launcher sizes anyway. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 0.29 fits the whole drawing inside the worst-case circular mask
         (66dp safe zone). The old 0.38 was clipping the outer pipes and
         the keybed corners on round launchers — nobody had looked. -->
    <group
        android:scaleX="0.29"
        android:scaleY="0.29"
        android:translateX="17.0"
        android:translateY="14.6">

        <!-- pipes -->
        <path android:fillColor="#C99A3A" android:pathData="M49.1,96h22v104h-22z" />
        <path android:fillColor="#C99A3A" android:pathData="M83.1,72h22v128h-22z" />
        <path android:fillColor="#C99A3A" android:pathData="M117.1,52h22v148h-22z" />
        <path android:fillColor="#C99A3A" android:pathData="M151.1,72h22v128h-22z" />
        <path android:fillColor="#C99A3A" android:pathData="M185.1,96h22v104h-22z" />

        <!-- pipe mouths (ellipses as pathData arcs) -->
        <path android:fillColor="#101014" android:fillAlpha="0.85"
            android:pathData="M53.1,176a7,4.5 0 1,0 14,0a7,4.5 0 1,0 -14,0z" />
        <path android:fillColor="#101014" android:fillAlpha="0.85"
            android:pathData="M87.1,168a7,4.5 0 1,0 14,0a7,4.5 0 1,0 -14,0z" />
        <path android:fillColor="#101014" android:fillAlpha="0.85"
            android:pathData="M121.1,160a7,4.5 0 1,0 14,0a7,4.5 0 1,0 -14,0z" />
        <path android:fillColor="#101014" android:fillAlpha="0.85"
